# Copy to .env.local for local overrides. All optional locally.

# Neon Postgres. Set automatically when you add Neon under Vercel → Storage.
# Leave unset locally to use the built-in PGlite database in ./.pglite
DATABASE_URL=

# Vercel Blob for cover uploads. Set automatically when you add a Blob store.
# Leave unset locally to save covers to public/uploads
BLOB_READ_WRITE_TOKEN=

# Password for adding books. Locally defaults to "letmein".
# In production, adding books is locked until this is set.
ADMIN_PASSWORD=
